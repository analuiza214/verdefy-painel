{
  // EXEMPLO: preencher recursos próprios; não executar contra a conta original.
  "name": "SEU-PAINEL",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-02",
  "vars": {
    "ADMIN_EMAIL": "administrador@example.com",
    "CF_ACCESS_TEAM_DOMAIN": "SUA-EQUIPE.cloudflareaccess.com",
    "CF_ACCESS_AUD": "AUD-DA-APLICACAO-ACCESS"
  },
  "d1_databases": [{
    "binding": "CENTRAL_DB",
    "database_name": "SEU-BANCO-CENTRAL",
    "database_id": "ID-DO-D1"
  }],
  "services": [{"binding": "META_CONNECTOR", "service": "SEU-WORKER-META"}]
}
